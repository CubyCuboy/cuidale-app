rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userId} {
      allow list: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow get, update, delete: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    match /fichas/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /perfil_cuidador/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == docId;
    }

    match /perfil_familiar/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == docId;
    }

    // Reglas para la colección de vínculos (Contactos)
    match /vinculos/{vinculoId} {
      allow read: if request.auth != null && (request.auth.uid in vinculoId.split("_"));
      allow create: if request.auth != null
                    && (request.auth.uid == request.resource.data.uid1 || request.auth.uid == request.resource.data.uid2);
      allow update, delete: if request.auth != null && (request.auth.uid in vinculoId.split("_"));
    }
  }
}
