rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function esParteDeSolicitud(solId) {
      let sol = get(/databases/$(database)/documents/solicitudes/$(solId)).data;
      return isAuthenticated() && (request.auth.uid == sol.representanteUid || request.auth.uid == sol.cuidadorUid);
    }

    // --- USUARIOS ---

    match /usuarios/{hashedRut} {
      allow read: if true;

      allow create: if isAuthenticated();

      allow update, delete: if isAuthenticated() && (
        resource == null ||
        !('uid' in resource.data) ||
        resource.data.uid == "" ||
        resource.data.uid == request.auth.uid ||
        resource.data.correo == request.auth.email ||
        (request.resource != null && request.resource.data.uid == request.auth.uid)
      );

      match /notificaciones/{notifId} {
        allow read, update, delete: if isAuthenticated();
        allow create: if isAuthenticated();
      }

      match /historial_cuenta/{entryId} {
        allow read, write: if isAuthenticated();
      }
    }

    // --- FICHAS TÉCNICAS ---
    match /fichas/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAuthenticated();

      match /{allSubcollections=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAuthenticated();
      }
    }

    // --- SOLICITUDES DE CUIDADO ---
    match /solicitudes/{solicitudId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.representanteUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.representanteUid == request.auth.uid ||
        resource.data.cuidadorUid == request.auth.uid
      );

      match /tareas_servicio/{taskId} {
        allow read: if esParteDeSolicitud(solicitudId);
        allow write: if isAuthenticated() && get(/databases/$(database)/documents/solicitudes/$(solicitudId)).data.representanteUid == request.auth.uid;
      }

      match /registros_tareas/{regId} {
        allow read: if esParteDeSolicitud(solicitudId);
        allow write: if esParteDeSolicitud(solicitudId);
      }
    }

    // --- VÍNCULOS Y MENSAJES ---
    match /vinculos/{vinculoId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.uids ||
        vinculoId.matches(".*" + request.auth.uid + ".*")
      );
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.uids;
      allow update, delete: if isAuthenticated() && request.auth.uid in resource.data.uids;

      match /mensajes/{mensajeId} {
        allow read, create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/vinculos/$(vinculoId)).data.uids;
        allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
      }
    }

    // --- POSTULACIONES ---
    match /postulaciones/{postulacionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.cuidadorUid ||
        request.auth.uid == resource.data.representanteUid
      );
    }

    // --- HISTORIAL DE SERVICIOS ---
    match /historial_servicios/{id} {
      allow read: if isAuthenticated() && (
        resource.data.representanteUid == request.auth.uid ||
        resource.data.cuidadorUid == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.representanteUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.representanteUid == request.auth.uid ||
        resource.data.cuidadorUid == request.auth.uid
      );
    }

    // --- INFORMES ---
    match /informes_servicios/{id} {
      allow read: if isAuthenticated() && (
        resource.data.representanteUid == request.auth.uid ||
        resource.data.cuidadorUid == request.auth.uid
      );
      allow create: if isAuthenticated();
    }
  }
}
