rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ¿El documento de usuario (por hashedRut) pertenece al solicitante?
    function esDuenoDeUsuario(hashedRut) {
      let userDoc = get(/databases/$(database)/documents/usuarios/$(hashedRut)).data;
      return userDoc != null && (
        userDoc.uid == request.auth.uid ||
        userDoc.correo == request.auth.email
      );
    }

    function esParteDeSolicitud(solId) {
      let sol = get(/databases/$(database)/documents/solicitudes/$(solId)).data;
      return isAuthenticated() && (request.auth.uid == sol.representanteUid || request.auth.uid == sol.cuidadorUid);
    }

    // --- USUARIOS ---

    match /usuarios/{hashedRut} {
      // Solo usuarios autenticados (bloquea enumeración anónima de RUTs).
      allow read: if isAuthenticated();

      // Solo se puede crear si el documento declara mi propio UID.
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAuthenticated() && (
        ('uid' in resource.data && resource.data.uid == request.auth.uid) ||
        ('correo' in resource.data && resource.data.correo == request.auth.email) ||
        (!('uid' in resource.data) && request.resource != null && request.resource.data.uid == request.auth.uid)
      );

      match /notificaciones/{notifId} {
        // Se permite crear notificaciones para OTROS usuarios (flujo push actual).
        allow create: if isAuthenticated();
        // Leer/marcar/eliminar: solo el destinatario o el dueño del documento.
        allow read, update, delete: if (
          resource.data.receptor == request.auth.uid ||
          esDuenoDeUsuario(hashedRut)
        );
      }

      match /historial_cuenta/{entryId} {
        allow read, write: if esDuenoDeUsuario(hashedRut);
      }
    }

    // --- FICHAS TÉCNICAS ---
    match /fichas/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // --- SOLICITUDES DE CUIDADO ---
    match /solicitudes/{solicitudId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.representanteUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.representanteUid == request.auth.uid ||
        resource.data.cuidadorUid == request.auth.uid
      );

      match /tareas_servicio/{taskId} {
        allow read: if esParteDeSolicitud(solicitudId);
        allow write: if isAuthenticated() && get(/databases/$(database)/documents/solicitudes/$(solicitudId)).data.representanteUid == request.auth.uid;
      }

      match /registros_tareas/{regId} {
        allow read: if esParteDeSolicitud(solicitudId);
        allow write: if esParteDeSolicitud(solicitudId);
      }
    }

    // --- VÍNCULOS Y MENSAJES ---
    // Los vínculos se identifican por el ID de documento de los usuarios (UID).
    // Se acepta la participación por uids o por uid1/uid2.
    match /vinculos/{vinculoId} {
      // Permitir consultar el documento aunque no exista (necesario para saber si
      // ya hay un vínculo antes de crearlo). Si existe, solo sus participantes.
      allow read: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/vinculos/$(vinculoId)) ||
        request.auth.uid in resource.data.uids ||
        resource.data.uid1 == request.auth.uid ||
        resource.data.uid2 == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.uids ||
        request.resource.data.uid1 == request.auth.uid ||
        request.resource.data.uid2 == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        request.auth.uid in resource.data.uids ||
        resource.data.uid1 == request.auth.uid ||
        resource.data.uid2 == request.auth.uid
      );

      match /mensajes/{mensajeId} {
        allow read, create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/vinculos/$(vinculoId)).data.uids;
        allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
      }
    }

    // --- POSTULACIONES ---
    match /postulaciones/{postulacionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.cuidadorUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.cuidadorUid ||
        request.auth.uid == resource.data.representanteUid
      );
    }

    // --- HISTORIAL DE SERVICIOS ---
    match /historial_servicios/{id} {
      allow read: if isAuthenticated() && (
        resource.data.representanteUid == request.auth.uid ||
        resource.data.cuidadorUid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.representanteUid == request.auth.uid ||
        request.resource.data.cuidadorUid == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.representanteUid == request.auth.uid ||
        resource.data.cuidadorUid == request.auth.uid
      );
    }

    // --- INFORMES ---
    match /informes_servicios/{id} {
      allow read: if isAuthenticated() && (
        resource.data.representanteUid == request.auth.uid ||
        resource.data.cuidadorUid == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.cuidadorUid == request.auth.uid;
    }

    // --- ARCHIVO DE MENSAJES (copia local en Firestore) ---
    match /archived_messages/{chatId} {
      allow read, write: if isAuthenticated() && request.auth.uid in chatId.split("_");

      match /history/{msgId} {
        allow read, write: if isAuthenticated() && request.auth.uid in chatId.split("_");
      }
    }
  }
}
