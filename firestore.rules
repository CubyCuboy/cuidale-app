rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (resource != null && resource.data.uid == request.auth.uid) ||
        (request.resource != null && request.resource.data.uid == request.auth.uid)
      );
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);

      match /notificaciones/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    match /fichas/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /tareas_plantilla/{taskId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    match /solicitudes/{solicitudId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.representanteUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.representanteUid == request.auth.uid ||
        resource.data.cuidadorUid == request.auth.uid
      );

      match /registros_tareas/{regId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    match /vinculos/{vinculoId} {
      allow read: if isAuthenticated() && (
        (resource != null && (request.auth.uid in resource.data.uids || resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid)) ||
        (resource == null && vinculoId.matches(".*" + request.auth.uid + ".*"))
      );
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.uids && request.resource.data.uids.size() == 2;
      allow update, delete: if isAuthenticated() && (request.auth.uid in resource.data.uids || resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid);

      match /mensajes/{mensajeId} {
        allow read, write: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/vinculos/$(vinculoId)).data.uids;
      }
    }

    match /postulaciones/{postulacionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    match /historial_servicios/{id} {
      allow read: if isAuthenticated() && (resource.data.representanteUid == request.auth.uid || resource.data.cuidadorUid == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.representanteUid == request.auth.uid || resource.data.cuidadorUid == request.auth.uid);
    }

    match /informes_servicios/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
  }
}
