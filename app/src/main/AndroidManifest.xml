<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Android 8 a 12L -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Android 13+ Notificaciones -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CuidaleApp"
        tools:targetApi="31">

        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CuidaleApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.RecoveryPasswordActivity"
            android:exported="false"
            android:label="@string/forgot_password_screen_title"
            android:theme="@style/Theme.CuidaleApp" />

        <activity
            android:name=".activities.MenuActivity"
            android:exported="false"
            android:label="Menú Principal"
            android:theme="@style/Theme.CuidaleApp" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:label="@string/register_title"
            android:theme="@style/Theme.CuidaleApp" />

        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:label="Perfil"
            android:theme="@style/Theme.CuidaleApp" />

        <activity
            android:name=".activities.EditProfileActivity"
            android:exported="false"
            android:label="Editar Perfil"
            android:theme="@style/Theme.CuidaleApp" />

        <activity
            android:name=".activities.FichaActivity"
            android:exported="false"
            android:label="Ficha Técnica"
            android:theme="@style/Theme.CuidaleApp" />

        <activity
            android:name=".activities.EmailVerificationActivity"
            android:exported="false"
            android:label="Verificación de Email"
            android:theme="@style/Theme.CuidaleApp" />

        <activity
            android:name=".activities.PhoneVerificationActivity"
            android:exported="false"
            android:label="Verificación de Teléfono"
            android:theme="@style/Theme.CuidaleApp" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:label="Configuración"
            android:theme="@style/Theme.CuidaleApp" />

        <activity
            android:name=".activities.SocialManagementActivity"
            android:exported="false"
            android:label="Gestión de Usuarios"
            android:theme="@style/Theme.CuidaleApp" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".services.CuidaleMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>